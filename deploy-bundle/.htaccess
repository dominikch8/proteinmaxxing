RewriteEngine On
RewriteBase /

Options -Indexes
DirectorySlash Off

# HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Artykuły dynamiczne: /artykul/slug → artykul.php
RewriteRule ^artykul/([^/]+)/?$ artykul.php?slug=$1 [L,QSA]

# Stary URL /glowna → strona główna
RewriteRule ^glowna/?$ / [R=301,L]

# Usunięty produkt → Corn Flakes
RewriteRule ^produkty/platki-sniadaniowe-cukier/?$ /produkty/platki-corn-flakes [R=301,L]

# Stary slug ziemniaki gotowane → tłuczone
RewriteRule ^produkty/ziemniaki-gotowane/?$ /produkty/ziemniaki-tluczone [R=301,L]
RewriteRule ^produkty/zywiec-zdroj-niegazowana/?$ /produkty/woda [R=301,L]
RewriteRule ^produkty/cisowianka-niegazowana/?$ /produkty/woda [R=301,L]
# Usunięty produkt Olimp Matrix Pro
RewriteRule ^produkty/olimp-matrix-pro/?$ /dieta [R=301,L]

# Slugi z nazwy (products-lite bez pola slug) → kanoniczne strony HTML
RewriteRule ^produkty/tofu/?$ /produkty/tofu-naturalne [R=301,L]
RewriteRule ^produkty/fasola-biala/?$ /produkty/fasola-biala-gotowana [R=301,L]
RewriteRule ^produkty/galareta-owocowa/?$ /produkty/galaretka-owocowa [R=301,L]
RewriteRule ^produkty/czekolada-toblerone/?$ /produkty/toblerone [R=301,L]
RewriteRule ^produkty/serek-homogenizowany-danio/?$ /produkty/serek-danio [R=301,L]
RewriteRule ^produkty/ryz-basmati-suchy/?$ /produkty/ryz-basmati [R=301,L]
RewriteRule ^produkty/ryz-arborio-suchy/?$ /produkty/ryz-arborio [R=301,L]

# Stare URL-e .html → czyste ścieżki (301)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /dieta lub /dieta/ → dieta.html
RewriteCond %{REQUEST_URI} ^/([^./]+)/?$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^[^./]+/?$ %1.html [L]

# /produkty/slug, /produkty/kategoria/x itd.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
